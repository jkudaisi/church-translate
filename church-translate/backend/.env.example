# Copy to .env and fill in. Leave the placeholders as they are for a
# credential-free sound check: the app starts in demo mode.

# demo = mock translation, text input, captions on this laptop
# live = Azure + Supabase (also the default once the keys below are real)
RUN_MODE=

# text (POST /ingest or the box on the laptop page), microphone, or file
INPUT_MODE=
# PCM WAV, 16 kHz 16-bit mono is the safest. Used only when INPUT_MODE=file.
AUDIO_FILE=
# Optional text file, one English line per line. Used when INPUT_MODE=text.
TEXT_FILE=

# mock or azure. Demo defaults to mock. Live defaults to azure.
TRANSLATION_MODE=
# local (this laptop's page) or supabase (phones). Demo defaults to local.
BROADCAST_MODE=

# Azure Speech resource. One resource covers speech translation and TTS.
AZURE_SPEECH_KEY=your-speech-key
AZURE_SPEECH_REGION=your-speech-region
# Optional. Leave blank to use the region above.
AZURE_SPEECH_ENDPOINT=

# Azure Translator resource. This is a different resource from Speech.
# Global endpoint, or the resource endpoint (https://<name>.cognitiveservices.azure.com).
AZURE_TRANSLATOR_KEY=your-translator-key
AZURE_TRANSLATOR_REGION=your-translator-region
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Supabase. The service key stays on this laptop. The anon key is public
# and is what output.html uses. Never put the service key in the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Spoken at the mic.
SOURCE_LANGUAGE=en-US

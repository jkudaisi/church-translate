# Azure Speech (Speech to Text, Translation, Text to Speech)
AZURE_SPEECH_KEY=your-speech-key
AZURE_SPEECH_REGION=your-speech-region
AZURE_SPEECH_ENDPOINT=https://your-region.api.cognitive.microsoft.com

# Azure Translator (text-only translation, used for Yoruba + Igbo captions)
AZURE_TRANSLATOR_KEY=your-translator-key
AZURE_TRANSLATOR_REGION=your-translator-region
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Supabase (for broadcasting captions/audio to output pages)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Source language spoken at the podium/mic
SOURCE_LANGUAGE=en-US
